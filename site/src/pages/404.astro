---
import Base from '../layouts/Base.astro';
const meta = {
  title: 'Page Not Found | The Erotic Morgan',
  description: 'The page you are looking for could not be found.',
};
---
<Base title={meta.title} description={meta.description}>
  <section class="section"><div class="wrap measure" style="text-align:center; padding: 4rem 0;">
    <p class="eyebrow">404</p>
    <h1>Page Not Found</h1>
    <p class="lede" style="margin: 1rem 0 2rem;">The page you're looking for doesn't exist.</p>
    <a class="btn btn-pink" href="/">Back to home</a>
  </div></section>
</Base>
