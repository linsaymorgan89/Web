---
import Base from '../layouts/Base.astro';
import { site } from '../data/content';

const meta = {
  title: 'Contact Morgan Alexander | Dallas Escort, 945-397-2900',
  description: 'Reach Morgan Alexander by phone or text at 945-397-2900, email morgan@theeroticmorgan.com, or find me on OnlyFans. Pre-booking recommended.',
};
const faq = site.contactFaq;
const phone = '+1' + site.phone.replace(/\D/g, '');
const phoneDisplay = '(' + site.phone.replace(/\D/g, '').replace(/^(\d{3})(\d{3})(\d{4})$/, '$1) $2-$3');
---
<Base title={meta.title} description={meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Morgan Alexander',
    url: 'https://theeroticmorgan.com/contact/',
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({
      '@type': 'Question', name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  })} />
  <section class="section">
    <div class="wrap measure">
      <p class="eyebrow">Contact</p>
      <h1>Get In Touch</h1>
      <p class="lede" style="margin: 1rem 0 2rem;">I am easy to get a hold of and schedule with.</p>

      <ul class="price-list">
              <li><span>Phone (fastest)</span><a href={`tel:${phone}`}>{phoneDisplay}</a></li>
              <li><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><span>OnlyFans</span><a href={`https://${site.onlyfans}`} rel="noopener">{site.onlyfans}</a></li>
              <li><span>Pre-booking</span><a href="/appointment-request/">Appointment request form</a></li>
            </ul>

      <div style="border-top:1px solid var(--grey-line); margin-top:3rem; padding-top:2rem;">
        <h2>Questions</h2>
        {faq.map(([q, a]) => (
          <div style="margin-bottom:1.5rem;">
            <h3 style="font-family:var(--font-body); font-size:1rem; font-weight:500;">{q}</h3>
            <p style="color:var(--ink-soft);">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
