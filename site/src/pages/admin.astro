---
import Base from '../layouts/Base.astro';
import { site, rates, tours, posts, categories } from '../data/content';
import { Image } from 'astro:assets';

const meta = {
  title: 'Admin | The Erotic Morgan',
  description: 'Manage site content: rates, tours, contact info, and blog posts.',
};

// Ensure we're not accidentally exposing this page in production builds without auth
// The actual auth gate is enforced via the API endpoints
---

<Base title={meta.title} description={meta.description}>
  <section class="section">
    <div class="wrap" style="max-width: 1200px;">
      <p class="eyebrow">Admin</p>
      <h1>Site Content Management</h1>
      <p class="lede" style="margin: 1rem 0 2rem;">
        Edit rates, tours, contact info, and blog posts. Click &quot;Publish&quot; to rebuild and deploy.
      </p>

      <!-- Tab Navigation -->
      <div id="admin-tabs" style="display: flex; gap: 0.5rem; border-bottom: 1px solid var(--grey-line); margin-bottom: 2rem; overflow-x: auto;">
        <button class="admin-tab active" data-tab="site">Site</button>
        <button class="admin-tab" data-tab="rates">Rates</button>
        <button class="admin-tab" data-tab="tours">Tours</button>
        <button class="admin-tab" data-tab="posts">Posts</button>
        <button class="admin-tab" data-tab="gallery">Gallery</button>
      </div>

      <!-- Tab Content -->
      <div id="admin-content">
        <!-- Site Tab -->
        <div id="tab-site" class="tab-pane active">
          <h2>Site Settings</h2>
          <p style="color: var(--ink-soft); margin-bottom: 1.5rem;">Contact info, homepage copy, and The Good Stuff details.</p>

          <form id="form-site" class="admin-form" style="display: grid; gap: 1.5rem; max-width: 600px;">
            <div>
              <label>Phone</label>
              <input name="phone" value={site.phone} required />
            </div>
            <div>
              <label>Email</label>
              <input name="email" type="email" value={site.email} required />
            </div>
            <div>
              <label>OnlyFans</label>
              <input name="onlyfans" value={site.onlyfans} required />
            </div>

            <h3 style="margin-top: 1.5rem; margin-bottom: 0.75rem;">The Good Stuff</h3>
            <div style="display: grid; gap: 1rem; max-width: 400px;">
              <div>
                <label>Price ($)</label>
                <input name="goodwill.price" value={site.goodwill.price} required />
              </div>
              <div>
                <label>Tagline</label>
                <input name="goodwill.tagline" value={site.goodwill.tagline} required />
              </div>
            </div>

            <h3 style="margin-top: 1.5rem; margin-bottom: 0.75rem;">Homepage</h3>
            <div>
              <label>Eyebrow</label>
              <input name="home.eyebrow" value={site.home.eyebrow} required />
            </div>
            <div>
              <label>Lede</label>
              <textarea name="home.lede" rows="3" required>{site.home.lede}</textarea>
            </div>
          </form>
        </div>

        <!-- Rates Tab -->
        <div id="tab-rates" class="tab-pane" style="display: none;">
          <h2>Rates</h2>
          <p style="color: var(--ink-soft); margin-bottom: 1.5rem;">Local, touring, and add-on pricing.</p>
          <div id="rates-loading">Loading...</div>
        </div>

        <!-- Tours Tab -->
        <div id="tab-tours" class="tab-pane" style="display: none;">
          <h2>Tours</h2>
          <p style="color: var(--ink-soft); margin-bottom: 1.5rem;">Upcoming and past tour announcements.</p>
          <div id="tours-loading">Loading...</div>
        </div>

        <!-- Posts Tab -->
        <div id="tab-posts" class="tab-pane" style="display: none;">
          <h2>Blog Posts</h2>
          <p style="color: var(--ink-soft); margin-bottom: 1.5rem;">Add, edit, or delete blog posts.</p>
          <div id="posts-loading">Loading...</div>
        </div>

        <!-- Gallery Tab -->
        <div id="tab-gallery" class="tab-pane" style="display: none;">
          <h2>Photo Gallery</h2>
          <p style="color: var(--ink-soft); margin-bottom: 1.5rem;">Upload new photos or delete existing ones from the public gallery page.</p>
          <div id="gallery-loading">Loading...</div>
        </div>
      </div>

      <!-- Actions -->
      <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--grey-line);">
        <p id="save-status" style="color: var(--ink-soft);"></p>
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <button id="btn-save" class="btn btn-pink">Save</button>
          <button id="btn-publish" class="btn">Save &amp; Publish</button>
        </div>
      </div>
    </div>
  </section>

  <style>
    .admin-tab {
      padding: 0.75rem 1.25rem;
      border: none;
      background: transparent;
      color: var(--ink-soft);
      font-family: var(--font-body);
      font-size: 1rem;
      cursor: pointer;
      border-bottom: 3px solid transparent;
      transition: all 0.2s ease;
    }
    .admin-tab:hover {
      color: var(--ink);
      background: rgba(0,0,0,0.03);
    }
    .admin-tab.active {
      color: var(--pink);
      border-bottom-color: var(--pink);
      font-weight: 500;
    }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }
    /* Input/select/textarea/label/radio/checkbox styling for .admin-form
       and the dynamically-rendered tabs now lives in the site-wide form
       system (src/styles/global.css) so the admin panel matches the rest
       of the site instead of having its own separate look. */
    .tour-preview, .post-preview {
      max-width: 200px;
      max-height: 150px;
      object-fit: cover;
      border-radius: 2px;
      margin-top: 0.5rem;
    }
    .post-form-row {
      display: grid;
      gap: 0.75rem;
    }
    .post-form-row.two-col {
      grid-template-columns: 1fr 1fr;
    }
  </style>

  <script src="/admin.js" defer></script>
</Base>
