---
import Base from '../layouts/Base.astro';
const meta = {
  title: 'Privacy Policy | The Erotic Morgan',
  description: 'How theeroticmorgan.com handles the information you share, cookies used, and your choices.',
};
---
<Base title={meta.title} description={meta.description}>
  <section class="section"><div class="wrap measure">
    <p class="eyebrow">Legal</p>
    <h1>Privacy Policy</h1>
    <div class="prose" style="margin-top:1.5rem;">
      <p>Discretion is the foundation of this site. The information you share here stays between us.</p>
      <p><strong>What I collect:</strong> appointment requests and membership registrations collect the name, email, phone number, and reference details you choose to provide. Payment for memberships is handled person-to-person (Zelle, Venmo, CashApp, PayPal, Apple Pay); no card data is ever collected by this site.</p>
      <p><strong>What I do with it:</strong> use it to respond to your request, schedule appointments, and activate your membership. I do not sell, rent, or share your information with anyone. Screening details are deleted when no longer needed.</p>
      <p><strong>Cookies:</strong> this site sets one cookie (age_ok) that remembers your age-gate confirmation. No advertising or tracking cookies are used.</p>
      <p><strong>Analytics:</strong> privacy-friendly, aggregate-only analytics that do not track you across other sites.</p>
      <p><strong>Removal:</strong> email <a href="mailto:morgan@theeroticmorgan.com">morgan@theeroticmorgan.com</a> and your registration details will be deleted.</p>
    </div>
  </div></section>
</Base>
