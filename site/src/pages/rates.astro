---
import Base from '../layouts/Base.astro';
import { rates } from '../data/content';

const meta = {
  title: 'Rates & Suggested Donations | Morgan Alexander, Dallas Escort',
  description: 'Check my suggested donations: local Dallas rates from $400/hr, touring rates, overnights, weekend trips, and add-ons. Wishlist link included.',
};

const local = rates.local;
const touring = rates.touring;
const addons = rates.addons;
---
<Base title={meta.title} description={meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [{
      '@type': 'Question',
      name: 'What are Morgan Alexander\u2019s rates in Dallas?',
      acceptedAnswer: { '@type': 'Answer', text: 'Local Dallas rates start at $400 for one hour, $700 for two hours (recommended), $1,000 for a three-hour dinner date, $1,500 overnight, and $2,500 for a weekend trip. Touring rates are higher.' },
    }],
  })} />
  <section class="section">
    <div class="wrap measure">
      <p class="eyebrow">Rates</p>
      <h1>Suggested Donations</h1>
      <p class="lede" style="margin: 1rem 0 2.5rem;">
        If you really want to make our time together special, check out my wishlist for gift ideas:
        <a href={rates.wishlistUrl} rel="noopener">{rates.wishlistLabel}</a>.
      </p>

      <h2 id="local">Local Rates</h2>
      <p style="color:var(--ink-soft);">Dallas only</p>
      <ul class="price-list" style="margin: 1rem 0 2.5rem;">
        {local.map(([name, price]) => <li><span>{name}</span><span class="price">${price}</span></li>)}
      </ul>

      <h2 id="touring">Touring Rates</h2>
      <p style="color:var(--ink-soft);">Helps cover touring expenses</p>
      <ul class="price-list" style="margin: 1rem 0 2.5rem;">
        {touring.map(([name, price]) => <li><span>{name}</span><span class="price">${price}</span></li>)}
      </ul>

      <h2 id="addons">Add-Ons</h2>
      <p style="color:var(--ink-soft);">Items in addition to the selected hourly rate</p>
      <ul class="price-list" style="margin: 1rem 0 2.5rem;">
        {addons.map(([name, price]) => <li><span>{name}</span><span class="price">${price}</span></li>)}
      </ul>

      <p><a class="btn" href="/appointment-request/">Request an appointment</a></p>
    </div>
  </section>
</Base>
