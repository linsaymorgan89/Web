---
import Base from '../layouts/Base.astro';
import { gallery } from '../data/content';

const meta = {
  title: 'Photo Gallery | Morgan Alexander\u2019s Sexy Photo Collection',
  description: 'Browse my favorite self-shot photos. Real, unretouched, and all me. Plus a portal to The Good Stuff for my very hottest pictures.',
};
---
<Base title={meta.title} description={meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: 'My Sexy Photo Collection',
    url: 'https://theeroticmorgan.com/photo-gallery/',
  })} />
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>My Sexy Photo Collection</h1>
      <div class="prose measure" style="margin: 1rem 0 2.5rem;">
        <p class="answer">These are my favorite self-shot photos: real, unretouched, and all me. For my very hottest pictures and videos, The Good Stuff offers lifetime access for one payment.</p>
        <p>These are just a few of my favorite sexy photos from my OnlyFans page. I love professional pictures but I feel like these photos were taken when I was at my sexiest and most comfortable. Plus I can add new ones whenever I want! I hope you enjoy looking at them. I certainly enjoyed taking them!</p>
      </div>

      <div class="photo-grid">
        {gallery.map((photo) => (
          <img src={photo.img} alt={photo.alt} width="576" height="1024"
               style="aspect-ratio: 9/16; object-fit:cover;" loading="lazy" />
        ))}
      </div>

      <div style="border:1px solid var(--pink-pale); background:var(--bg-ivory); padding:2rem; margin:3rem 0;" class="measure">
        <h2>The Good Stuff</h2>
        <p style="margin: 0.75rem 0 1.25rem;">Want access to pics so hot I don&rsquo;t even put them on my OnlyFans? Get unlimited access to my sexiest nudes and videos for one low price, forever. No re-occurring fees, just all the Morgan you can enjoy in private!</p>
        <a class="btn btn-pink" href="/register/">Register</a>
        &nbsp; <a href="/login/">Login</a>
      </div>
      <p class="measure">To view more check out my OnlyFans page at <a href="https://onlyfans.com/theeroticmorgan" rel="noopener">onlyfans.com/theeroticmorgan</a></p>
    </div>
  </section>
</Base>
